# Конфигурация backend (скопируйте в .env и заполните).

# Порт и хост (по умолчанию 0.0.0.0:8080)
PORT=8080
HOST=0.0.0.0

# Режим минта cNFT: mock (по умолчанию, детерминированная заглушка) | solana
PIEGEDDON_MINT_MODE=mock

# Для режима solana (см. docs/DEPLOY.md):
#   npm i @metaplex-foundation/umi @metaplex-foundation/umi-bundle-defaults @metaplex-foundation/mpl-bubblegum
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BUBBLEGUM_TREE=
NFT_COLLECTION=
PAYER_KEYPAIR_PATH=

# Хранилище (JSON-файл базы; в проде заменяется Postgres)
PIEGEDDON_DATA=./data

# Сезон
SEASON_ID=1
SEASON_NAME=Сезон 1: Первый Ломоть

# Путь к статике веб-игры (по умолчанию ../web)
# WEB_ROOT=/srv/piegeddon/web
